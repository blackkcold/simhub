# Required. Generate with: python3 scripts/gen_admin_token.py
SIMHUB_ADMIN_TOKEN=change-me-with-at-least-32-random-bytes

# RFC 6238 TOTP. Required by default; generate with: python3 scripts/gen_totp_secret.py
# Set SIMHUB_REQUIRE_TOTP=false only for an intentionally isolated development relay.
SIMHUB_REQUIRE_TOTP=true
SIMHUB_TOTP_SECRET=

SIMHUB_BIND=0.0.0.0
SIMHUB_PORT=8787
SIMHUB_DB=/data/simhub.db
SIMHUB_WEB_ROOT=/app/web
# The Android/Modem enrollment address. Must remain reachable without web login.
SIMHUB_PUBLIC_BASE_URL=https://node.simhub.example.com
# Browser administration address, with independent upstream identity protection.
SIMHUB_MANAGEMENT_ORIGIN=https://admin.simhub.example.com
# Only enable after moving existing Android/Modem nodes to the node address.
SIMHUB_SEPARATE_SURFACES=true
SIMHUB_SESSION_IDLE_TTL=900
SIMHUB_STEPUP_TTL=120
SIMHUB_MAX_HTTP_CONNECTIONS=64
SIMHUB_MAX_SSE_PER_SESSION=3
SIMHUB_HTTP_TIMEOUT=15
# Linux Modem Agent quota is configured separately in its service environment.
# SIMHUB_SMS_PER_HOUR=10

# Enrollment token lifetime in seconds.
SIMHUB_ENROLL_TTL=600
# Command default lifetime in seconds.
SIMHUB_COMMAND_TTL=120
# Device is shown offline after this many seconds.
SIMHUB_OFFLINE_AFTER=180
# 0 keeps relay ciphertext indefinitely; otherwise purge events older than N days continuously.
SIMHUB_EVENT_RETENTION_DAYS=30
SIMHUB_AUDIT_RETENTION_DAYS=180
SIMHUB_COMMAND_RETENTION_DAYS=30
SIMHUB_MAINTENANCE_INTERVAL=3600

# Only trust forwarded client IP headers when the TCP peer is inside these CIDRs.
# The Compose service separately opts into trusting only its detected Docker bridge gateway.
# Adjust for other reverse-proxy networks; never use 0.0.0.0/0.
SIMHUB_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Optional generic notification webhook. Server sends only metadata, never SMS body/OTP.
SIMHUB_NOTIFY_WEBHOOK_URL=
SIMHUB_NOTIFY_WEBHOOK_BEARER=

# Optional OTA metadata file mounted into the server.
SIMHUB_OTA_FILE=/data/ota.json

# Browser admin sessions. TOTP is checked when a session is created, not on every API poll.
SIMHUB_SESSION_TTL=28800

# Notification filtering. Only fresh sms.received events are eligible.
SIMHUB_NOTIFY_OTP_ONLY=false
SIMHUB_NOTIFY_MAX_AGE=300
# Optional comma-separated device IDs. Empty means all devices.
SIMHUB_NOTIFY_DEVICE_IDS=

# Optional metadata-only push/tickle adapter. The external adapter maps deviceId
# to FCM/vendor push and wakes the Android Agent to fetch commands over HTTPS.
SIMHUB_PUSH_TICKLE_URL=
SIMHUB_PUSH_TICKLE_BEARER=

# Optional metadata-only mobile push (configure at most one provider to avoid duplicates)
# SIMHUB_NOTIFY_BARK_URL=https://api.day.app/YOUR_BARK_DEVICE_KEY
# SIMHUB_NOTIFY_NTFY_URL=https://ntfy.example.com/private-simhub-topic
# SIMHUB_NOTIFY_NTFY_TOKEN=YOUR_NTFY_ACCESS_TOKEN
