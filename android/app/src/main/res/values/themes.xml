<resources>
<style name="Theme.SimHub" parent="android:style/Theme.Material.Light.NoActionBar"><item name="android:fontFamily">sans</item><item name="android:windowActionModeOverlay">true</item><item name="android:navigationBarColor">@color/page_bg</item><item name="android:statusBarColor">@color/page_bg</item><item name="android:windowLightStatusBar">true</item><item name="android:colorAccent">@color/brand_primary</item><item name="android:windowBackground">@color/page_bg</item></style>
<style name="SectionTitle"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">22dp</item><item name="android:layout_marginBottom">8dp</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">17sp</item><item name="android:textStyle">bold</item></style>
<style name="PrimaryButton" parent="android:style/Widget.Material.Button"><item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item><item name="android:backgroundTint">@color/button_primary</item><item name="android:textColor">@color/button_primary_text</item><item name="android:textAllCaps">false</item><item name="android:textStyle">bold</item></style>
<style name="SecondaryButton" parent="android:style/Widget.Material.Button"><item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item><item name="android:backgroundTint">@color/button_secondary</item><item name="android:textColor">@color/button_secondary_text</item><item name="android:textAllCaps">false</item></style>
<style name="DangerButton" parent="android:style/Widget.Material.Button"><item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item><item name="android:backgroundTint">@color/button_secondary</item><item name="android:textColor">@color/danger</item><item name="android:textAllCaps">false</item></style>
</resources>