<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/page_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_title" android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/dashboard_subtitle" android:textColor="@color/text_secondary" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_section" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/status_not_enrolled" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView style="@style/SectionTitle" android:text="@string/enrollment_section" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/enrollment_help" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <EditText android:id="@+id/enrollLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_input" android:hint="@string/enrollment_hint" android:inputType="textUri" android:minHeight="52dp" android:padding="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary" />
            <Button android:id="@+id/enrollButton" style="@style/PrimaryButton" android:layout_marginTop="12dp" android:text="@string/enroll_button" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_warning" android:padding="12dp" android:text="@string/mms_warning" android:textColor="@color/warning_text" android:textSize="12sp" />
        </LinearLayout>
        <TextView style="@style/SectionTitle" android:text="@string/setup_section" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
            <Button android:id="@+id/smsRoleButton" style="@style/SecondaryButton" android:text="@string/make_default_sms" />
            <Button android:id="@+id/permissionButton" style="@style/SecondaryButton" android:layout_marginTop="10dp" android:text="@string/grant_core_permissions" />
            <Button android:id="@+id/contactButton" style="@style/SecondaryButton" android:layout_marginTop="10dp" android:text="@string/enable_contacts" />
        </LinearLayout>
        <TextView style="@style/SectionTitle" android:text="@string/relay_section" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
            <Button android:id="@+id/startRelayButton" style="@style/PrimaryButton" android:text="@string/start_relay" />
            <Button android:id="@+id/stopRelayButton" style="@style/SecondaryButton" android:layout_marginTop="10dp" android:text="@string/stop_relay" />
            <Button android:id="@+id/syncButton" style="@style/SecondaryButton" android:layout_marginTop="10dp" android:text="@string/sync_now" />
            <Button android:id="@+id/refreshButton" style="@style/SecondaryButton" android:layout_marginTop="10dp" android:text="@string/refresh_state" />
        </LinearLayout>
        <TextView style="@style/SectionTitle" android:text="@string/settings_section" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/language_label" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
            <Spinner android:id="@+id/languageSpinner" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" />
            <Switch android:id="@+id/developerSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:minHeight="48dp" android:text="@string/developer_mode" android:textColor="@color/text_primary" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/developer_mode_help" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <LinearLayout android:id="@+id/developerTools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:visibility="gone">
                <Button android:id="@+id/viewLogsButton" style="@style/SecondaryButton" android:text="@string/view_logs" />
                <Button android:id="@+id/exportLogsButton" style="@style/SecondaryButton" android:layout_marginTop="8dp" android:text="@string/export_diagnostics" />
                <Button android:id="@+id/clearLogsButton" style="@style/SecondaryButton" android:layout_marginTop="8dp" android:text="@string/clear_logs" />
                <TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_code" android:fontFamily="monospace" android:padding="12dp" android:textColor="@color/text_secondary" android:textIsSelectable="true" android:textSize="11sp" />
            </LinearLayout>
            <Button android:id="@+id/otaButton" style="@style/SecondaryButton" android:layout_marginTop="14dp" android:text="@string/check_update" />
            <Button android:id="@+id/resetEnrollmentButton" style="@style/DangerButton" android:layout_marginTop="10dp" android:text="@string/reset_enrollment" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>