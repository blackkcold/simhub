# Required. Generate with: python3 scripts/gen_admin_token.py
SIMHUB_ADMIN_TOKEN=change-me-with-at-least-32-random-bytes

# Optional RFC 6238 TOTP secret in Base32. Leave empty to disable TOTP.
SIMHUB_TOTP_SECRET=

SIMHUB_BIND=0.0.0.0
SIMHUB_PORT=8787
SIMHUB_DB=/data/simhub.db
SIMHUB_WEB_ROOT=/app/web
SIMHUB_PUBLIC_BASE_URL=https://simhub.example.com

# Enrollment token lifetime in seconds.
SIMHUB_ENROLL_TTL=600
# Command default lifetime in seconds.
SIMHUB_COMMAND_TTL=120
# Device is shown offline after this many seconds.
SIMHUB_OFFLINE_AFTER=180

# Optional generic notification webhook. Server sends only metadata, never SMS body/OTP.
SIMHUB_NOTIFY_WEBHOOK_URL=
SIMHUB_NOTIFY_WEBHOOK_BEARER=

# Optional OTA metadata file mounted into the server.
SIMHUB_OTA_FILE=/data/ota.json
